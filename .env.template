# =============================================================================
# Metaculus bot environment variables
#
# How to use:
#   1) Copy this file to `.env` in the same directory.
#        cp .env.template .env
#   2) Replace each `REPLACE_ME` below with your real key.
#   3) Save. The bot will read `.env` automatically on startup.
#
# In GitHub Actions, do NOT commit your `.env`. Instead, add each variable
# under Settings → Secrets and variables → Actions → New repository secret.
# =============================================================================


# ---- REQUIRED -----------------------------------------------------------------
# Your Metaculus bot account token. Without this, the bot cannot read questions
# or post forecasts. Get one at: https://www.metaculus.com/futureeval/participate/
METACULUS_TOKEN=REPLACE_ME

# Anthropic API key. This fork runs entirely on Claude models.
# Get one at: https://platform.claude.com/ (API keys)
ANTHROPIC_API_KEY=REPLACE_ME


# ---- OPTIONAL TUNING (all have safe defaults, see bot_config.py) ---------------
# In GitHub Actions set these as repository *Variables*, not secrets.
#
# Models (litellm names). Main model does research + forecasting, fallback is
# used when the main model errors/times out and also does parsing/summaries.
# BOT_MAIN_MODEL=anthropic/claude-sonnet-5-5
# BOT_FALLBACK_MODEL=anthropic/claude-haiku-5-5
# BOT_EFFORT=medium            # low | medium | high (thinking depth of the main model)
#
# Research: "web_search" (Claude's web search tool, ~3 searches/question) or "none".
# BOT_RESEARCH_MODE=web_search
#
# Hard spend caps in USD. The bot refuses to start another LLM call once a cap
# is reached. The daily cap is remembered across Actions runs via a cache.
# BOT_MAX_COST_PER_RUN_USD=4
# BOT_MAX_COST_PER_DAY_USD=12
#
# How many independent forecasts to average per question (more = pricier).
# BOT_PREDICTIONS_PER_QUESTION=3
#
# Set to false to reason and log without posting anything to Metaculus.
# BOT_PUBLISH=true


# ---- OTHER PROVIDERS (not used by this fork's workflows) -----------------------
# OPENROUTER_API_KEY=REPLACE_ME
# OPENAI_API_KEY=REPLACE_ME
# PERPLEXITY_API_KEY=REPLACE_ME
# EXA_API_KEY=REPLACE_ME
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME


# ---- INTEGRATIONS (optional) --------------------------------------------------
# See integrations/README.md for details.
# LightningRod: https://lightningrod.ai/
# LIGHTNINGROD_API_KEY=REPLACE_ME
